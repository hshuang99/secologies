---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config, { monolocale } from "$config";
import Time from "$lib/time";
import Base from "$layouts/Base.astro";
import TOC from "$components/TOC.astro";
import Position from "$components/Position.astro";
import Comments from "$components/Comments.svelte";
import Icon from "$components/Icon.svelte";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Get all published entries
	const entries = await getCollection("project", entry => !entry.data.draft);

	return entries.map(entry => {
		let locale: string | undefined;
		let id: string;

		if (monolocale) {
			locale = undefined;
			id = entry.id;
		} else {
			// Extract language and entry ID from file path structure
			const [language, ...ids] = entry.id.split("/");

			locale = config.i18n.defaultLocale === language ? undefined : language;
			id = ids.join("/");
		}

		// Generate path params with optional locale (omit for default locale)
		return { params: { locale, id }, props: { entry } };
	});
}

const { locale = config.i18n.defaultLocale } = Astro.params;
const { entry } = Astro.props;

// Render markdown content and extract headings for TOC
const { Content, headings, remarkPluginFrontmatter: frontmatter } = await render(entry);

// Other entries of the same series, in publication order, for the series navigation
const series = entry.data.series
	? (
			await getCollection(
				"project",
				item => !item.data.draft && item.data.series === entry.data.series && (monolocale || item.id.startsWith(`${locale}/`))
			)
		)
			.sort((a, b) => a.data.timestamp.getTime() - b.data.timestamp.getTime())
			.map(item => ({
				title: item.data.title,
				url: getRelativeLocaleUrl(locale, `/project/${monolocale ? item.id : item.id.split("/").slice(1).join("/")}`),
				current: item.id === entry.id
			}))
	: undefined;

const t = i18nit(locale);
---

<Base title={entry.data.title} {locale} description={entry.data.description} article={{ timestamp: entry.data.timestamp, section: entry.data.series, tags: entry.data.tags }}>
	<main class="flex flex-col gap-6">
		<header class="flex flex-col gap-4">
			<h1 class="select-text">{entry.data.title}</h1>
			<div class="flex flex-col gap-3 sm:flex-row *:flex *:items-center *:gap-1 *:text-[0.875rem] *:text-secondary">
				<time datetime={entry.data.timestamp.toISOString()}><Icon name="lucide--calendar" />{Time.toString(entry.data.timestamp)}</time>
				{
					entry.data.series && (
						<span>
							<Icon name="lucide--layers" />
							{entry.data.series}
						</span>
					)
				}
				{
					!!entry.data.tags?.length && (
						<span>
							<Icon name="lucide--hash" />
							{entry.data.tags?.join("; ")}
						</span>
					)
				}
				<span><Icon name="lucide--pilcrow" />{t("read.words", { count: frontmatter.words })}</span>
			</div>
			<hr class="border-b border-weak" />
		</header>

		<div class="flex gap-5">
			<section id="markdown-content" class="markdown"><Content /></section>
			{(entry.data.toc || !!entry.data.series) && <TOC headings={entry.data.toc ? headings : undefined} {locale} {series} />}
		</div>

		<Comments {locale} slug={`project/${entry.id}`} client:visible />

		<Position {locale} toc={entry.data.toc} series={!!entry.data.series} />
	</main>
</Base>
