---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config, { monolocale } from "$config";
import Base from "$layouts/Base.astro";
import Collection from "$components/Collection.svelte";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Create path for each locale, omitting default locale from URL
	return config.i18n.locales.map(locale => ({ params: { locale: config.i18n.defaultLocale === locale ? undefined : locale } }));
}

const { locale = config.i18n.defaultLocale } = Astro.params;

const t = i18nit(locale);

const entries = await getCollection("project", entry => !entry.data.draft && (monolocale || entry.id.split("/")[0] === locale));

// Standardize entry structure
const list = entries.map(entry => ({
	id: entry.id,
	url: getRelativeLocaleUrl(locale, `/project/${monolocale ? entry.id : entry.id.split("/").slice(1).join("/")}`),
	data: {
		title: entry.data.title,
		timestamp: entry.data.timestamp,
		description: entry.data.description,
		series: entry.data.series,
		tags: entry.data.tags
	}
}));

// Extract all unique series and tags from the filtered entries
const series = Array.from(new Set(entries.map(entry => entry.data.series).filter((series): series is string => Boolean(series)))).sort();
const tags = Array.from(new Set(entries.flatMap(entry => entry.data.tags).filter((tag): tag is string => Boolean(tag)))).sort();
---

<Base title={t("navigation.project")} {locale}>
	<main class="flex flex-col grow">
		<Collection client:load {locale} section="project" entries={list} {series} {tags} />
	</main>
</Base>
