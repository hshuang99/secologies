---
import { render, getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import config, { monolocale } from "$config";
import Time from "$lib/time";
import localize from "$lib/localize";
import Base from "$layouts/Base.astro";
import Heatmap from "$components/Heatmap.astro";
import Entries from "$components/Entries.astro";
import Icon from "$components/Icon.svelte";
import Newsletter from "$components/Newsletter.astro";
import Logo from "$icons/site-logo.svg";
import i18nit from "$i18n";

export async function getStaticPaths() {
	// Create path for each locale, omitting default locale from URL
	return config.i18n.locales.map(locale => ({ params: { locale: config.i18n.defaultLocale === locale ? undefined : locale } }));
}

const { locale = config.i18n.defaultLocale } = Astro.params;
const siteTitle = localize(config.title, locale);
const prologue = localize(config.prologue, locale);

const t = i18nit(locale);

// Get preface content for current locale, sorted by timestamp (latest first)
const prefaces = (
	await getCollection("preface", preface => {
		// Handle single locale setup
		if (monolocale) return true;

		// Extract language and ID from file path structure
		const [language, id] = preface.id.split("/");
		preface.id = id;

		// Filter by current locale
		return language === locale;
	})
).sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());

// Get published notes for current locale
const notes = await getCollection("note", note => {
	// Assign type property
	Reflect.set(note, "type", "note");

	// Filter by publication status and locale
	let published = !note.data.draft;
	let localed = monolocale || note.id.split("/")[0] === locale;

	// Filter published notes by current locale
	return published && localed;
});

// Get published jottings for current locale
const jottings = await getCollection("jotting", jotting => {
	// Assign type property
	Reflect.set(jotting, "type", "jotting");

	// Check monolocale setup or extract language to match locale
	let localed = monolocale || jotting.id.split("/")[0] === locale;

	// Filter published notes by current locale
	return !jotting.data.draft && localed;
});

// Get published projects for current locale
const projects = await getCollection("project", project => {
	// Assign type property
	Reflect.set(project, "type", "project");

	return !project.data.draft && (monolocale || project.id.split("/")[0] === locale);
});

// Get published podcast episodes for current locale
const podcasts = await getCollection("podcast", podcast => {
	// Assign type property
	Reflect.set(podcast, "type", "podcast");

	return !podcast.data.draft && (monolocale || podcast.id.split("/")[0] === locale);
});

// Combine contents
let items: { id: string; type?: string; data: { timestamp: Date; tags?: string[]; [key: string]: any } }[] = [];

// Determine which sections to include
const sections = config.latest || "*";

// Add contents based on config
if (sections === "*" || sections.includes("note")) items = items.concat(notes);
if (sections === "*" || sections.includes("jotting")) items = items.concat(jottings);
if (sections === "*" || sections.includes("project")) items = items.concat(projects);
if (sections === "*" || sections.includes("podcast")) items = items.concat(podcasts);

// Get the latest content for display
const sorted = items.sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime());
const latest = sorted[0];
const recent = sorted.slice(0, 5);

const urlOf = (item: { id: string; type?: string }) =>
	getRelativeLocaleUrl(locale, `/${item.type}/${monolocale ? item.id : item.id.split("/").slice(1).join("/")}`);

// Latest projects and podcast episodes, shown as sections (hidden while a collection is empty)
const latestOf = async (name: "project" | "podcast") =>
	(await getCollection(name, entry => !entry.data.draft && (monolocale || entry.id.split("/")[0] === locale)))
		.sort((a, b) => b.data.timestamp.getTime() - a.data.timestamp.getTime())
		.slice(0, 3)
		.map(entry => ({
			title: entry.data.title,
			url: getRelativeLocaleUrl(locale, `/${name}/${monolocale ? entry.id : entry.id.split("/").slice(1).join("/")}`),
			timestamp: entry.data.timestamp,
			description: entry.data.description,
			meta: "episode" in entry.data && entry.data.episode ? t("podcast.episode", { count: entry.data.episode }) : undefined
		}));

const showcase = [
	{ key: "project", items: await latestOf("project") },
	{ key: "podcast", items: await latestOf("podcast") }
].filter(section => section.items.length > 0);

// Get the latest preface for display
const preface = prefaces[0];
// Render preface content if available, otherwise use empty object
const { Content } = preface ? await render(preface) : ({} as any);
---

<Base title={t("navigation.home")} {locale}>
	<main class="flex flex-col gap-5 sm:gap-20 grow">
		<header class="flex items-center justify-center flex-wrap-reverse grow-[0.6]">
			<h1 class="sr-only">{siteTitle}</h1>
			{prologue && <article class="me-auto font-cursive font-thin text-xl sm:text-2xl leading-loose whitespace-pre-line">{prologue}</article>}
		</header>

		{
			preface && (
				<section class="flex flex-col">
					<article class="markdown">
						<Content />
					</article>
					<a href={getRelativeLocaleUrl(locale, "/preface")} class="self-end my-2 text-sm text-secondary">
						—— {Time.toLocaleDateString(preface.data.timestamp, locale)}
					</a>
				</section>
			)
		}

		{
			latest && (
				<footer class="flex items-start justify-center flex-wrap-reverse gap-10">
					<Heatmap {locale} {notes} {jottings} />

					<div class="grow flex flex-col gap-2">
						<h4>{t("home.latest")}</h4>
						<ul class="flex flex-col gap-2 list-none">
							{recent.map(item => (
								<li class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-x-4">
									<a href={urlOf(item)} class="link">
										{item.data.series && `${item.data.series} | `}
										{item.data.title}
									</a>
									<time datetime={item.data.timestamp.toISOString()} class="shrink-0 text-secondary font-mono text-xs">
										{Time.toString(item.data.timestamp)}
									</time>
								</li>
							))}
						</ul>
					</div>
				</footer>
			)
		}

		{
			showcase.length > 0 && (
				<div class="grid items-start gap-10 sm:grid-cols-2">
					{showcase.map(section => (
						<section class="flex flex-col gap-4">
							<a href={getRelativeLocaleUrl(locale, `/${section.key}`)} class="inline-flex items-center gap-2 self-start">
								<h2>{t(`navigation.${section.key}`)}</h2>
								<Icon name="lucide--arrow-right" />
							</a>
							<Entries items={section.items} />
						</section>
					))}
				</div>
			)
		}

		<Newsletter {locale} />
	</main>
</Base>
