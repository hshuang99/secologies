---
import { getCollection } from 'astro:content';
import { shouldShowContent } from '@/utils/markdown';
import { siteConfig } from '@/config';
import PodcastLayout from '@/layouts/PodcastLayout.astro';

export async function getStaticPaths() {
  // If podcasts are disabled, don't generate any paths
  if (!siteConfig.optionalContentTypes.podcasts) {
    return [];
  }
  
  const podcasts = await getCollection('podcasts');
  const isDev = import.meta.env.DEV;
  
  const paths = [];
  
  // Generate paths for all podcasts - each .md file is a separate doc
  for (const doc of podcasts) {
    if (!shouldShowContent(doc, isDev)) continue;
    
    // Use the full doc ID as the slug (e.g., "api" or "sourcetree-and-git-setup")
    const slug = doc.id;
    
    paths.push({
      params: { slug: slug },
      props: { 
        podcast: doc 
      }
    });
  }
  
  return paths;
}

const { podcast } = Astro.props;

if (!podcast) {
  return Astro.redirect('/podcasts/', 404);
}
---

<PodcastLayout podcast={podcast} />

