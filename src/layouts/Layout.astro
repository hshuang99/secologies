---
import '../styles/terminal.css';
import 'katex/dist/katex.min.css';
import TerminalHeader from '../components/TerminalHeader.astro';
import TerminalFooter from '../components/TerminalFooter.astro';
import HackGate from '../components/HackGate.astro';
import {
  PRIVATE_MODE,
  SITE_VENDOR,
  SITE_SYSTEM,
  SITE_MODEL,
} from '../consts';
import { LOCALE_CODES, LOCALES, type Locale } from '../i18n/config';
import {
  buildSwitcher,
  getLangFromUrl,
  localePath,
  useTranslations,
} from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Counterparts of this page per language (for the switcher and hreflang). */
  alternates?: Partial<Record<Locale, string>>;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const SITE_TITLE = t('site.title');
const { title, description = t('site.description'), alternates } = Astro.props;
const pageTitle = title ? `${title} // ${SITE_TITLE}` : SITE_TITLE;
const switcher = buildSwitcher(lang, Astro.url, alternates);
const hreflangs = alternates
  ? LOCALE_CODES.filter((code) => alternates[code]).map((code) => ({
      code,
      href: new URL(alternates[code]!, Astro.site),
    }))
  : [];
const nextLang = switcher[(switcher.findIndex((l) => l.current) + 1) % switcher.length];
---

<!doctype html>
<html lang={LOCALES[lang].htmlLang}>
  <head>
      <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3SYX4FZGQ3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', 'G-3SYX4FZGQ3');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0c1710" />
    <meta property="og:locale" content={LOCALES[lang].htmlLang.replace('-', '_')} />
    {
      hreflangs.map(({ code, href }) => (
        <link rel="alternate" hreflang={LOCALES[code].htmlLang} href={href} />
      ))
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/WebPlus_IBM_VGA_8x16.woff"
      as="font"
      type="font/woff"
      crossorigin
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE_TITLE}
      href={new URL(localePath(lang, '/rss.xml'), Astro.site)}
    />
    <title>{pageTitle}</title>
  </head>
  <body
    data-home={localePath(lang, '/')}
    data-archive={localePath(lang, '/blog/')}
    data-search={localePath(lang, '/search/')}
    data-next-lang={nextLang.href}
    data-snd-on={t('toggle.sound')}
    data-snd-off={t('toggle.soundOff')}
  >
    <!-- Power-on screen: once per session, dismissed by any click or key. -->
    <div class="crt-boot" id="crt-boot" aria-hidden="true">
      <div class="crt-boot__screen">
        <pre class="crt-boot__lines">{[
          `${SITE_VENDOR} (TM) ${SITE_SYSTEM} PROTOCOL`,
          `INITIALIZING ${SITE_MODEL}...`,
          '',
          '> SET TERMINAL/INQUIRE',
          SITE_MODEL,
          '> SET FILE/PROTECTION=OWNER:RWED ACCOUNTS.F',
          '> SET HALT RESTART/MAINT',
          '',
          `INITIALIZING ${SITE_VENDOR}(TM) BOOT AGENT v2.3.0`,
          'RETROS BIOS  RBIOS-4.02.08.00 52EE5.E7.E8',
          `COPYRIGHT 1984-1991 ${SITE_VENDOR}`,
          'UPPERMEM: 64 KB   ROOT: 05EAC8FF',
          'EXECUTING THREAD...',
          'LOAD ' + SITE_TITLE + ' // READY',
        ].map((line, i) => (
          <span class="boot-line" style={`--i:${i}`}>{line + '\n'}</span>
        ))}</pre>
        <div class="crt-boot__skip">{t('boot.skip')}</div>
      </div>
    </div>
    <script is:inline>
      // Skip the screen entirely rather than flashing it and hiding it.
      (function () {
        var boot = document.getElementById('crt-boot');
        if (!boot) return;
        var mq = window.matchMedia;
        var reduce = mq && mq('(prefers-reduced-motion: reduce)').matches;
        var narrow = mq && mq('(max-width: 640px)').matches;
        if (reduce || narrow || sessionStorage.getItem('booted')) {
          boot.classList.add('crt-boot--off');
        }
      })();
    </script>

    {PRIVATE_MODE && <HackGate />}

    <div class="crt">
      <div class="container">
        <TerminalHeader lang={lang} switcher={switcher} />
        <main>
          <slot />
        </main>
        <TerminalFooter lang={lang} switcher={switcher} />
      </div>
    </div>

    <script>
      import { sfx, bindSfx } from '../scripts/sfx';

      // Links, buttons and list rows all sound like menu items.
      bindSfx(document, '.menu-item, .h-nav a, .h-nav button, .logo, [data-sfx]');

      // Two sound buttons exist (header and footer) and only one is ever
      // visible, but both have to stay in sync.
      const soundBtns = document.querySelectorAll<HTMLButtonElement>(
        '[data-action="sound"]',
      );

      function drawSound() {
        soundBtns.forEach((btn) => {
          btn.setAttribute('aria-pressed', String(sfx.enabled));
          const label = btn.querySelector<HTMLElement>('[data-sound-label]');
          if (label) {
            const d = document.body.dataset;
            label.textContent = (sfx.enabled ? d.sndOn : d.sndOff) ?? '';
          }
        });
      }
      drawSound();

      soundBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          sfx.enabled = !sfx.enabled;
          drawSound();
          if (sfx.enabled) sfx.select(); // Confirm switching on, audibly.
        }),
      );

      (function () {
        const boot = document.getElementById('crt-boot');
        if (!boot || boot.classList.contains('crt-boot--off')) return;
        sessionStorage.setItem('booted', '1');
        let done = false;
        const dismiss = () => {
          if (done) return;
          done = true;
          boot.classList.add('crt-boot--done');
          setTimeout(() => boot.remove(), 400);
        };
        boot.addEventListener('click', dismiss);
        // Catch the key before the nav hotkeys so it only dismisses boot.
        window.addEventListener(
          'keydown',
          (e) => {
            e.stopImmediatePropagation();
            dismiss();
          },
          { once: true, capture: false },
        );
        setTimeout(dismiss, 2600);
      })();

      // Mermaid: only downloaded on pages that actually contain a diagram.
      // ```mermaid fences render as <pre><code class="language-mermaid">.
      (async function () {
        const codes = document.querySelectorAll<HTMLElement>(
          'pre > code.language-mermaid',
        );
        if (!codes.length) return;
        const { default: mermaid } = await import('mermaid');
        // Colors come from the CSS variables, so terminal.css stays the one
        // place where the palette is defined.
        const css = getComputedStyle(document.documentElement);
        const v = (name: string) => css.getPropertyValue(name).trim();
        mermaid.initialize({
          startOnLoad: false,
          securityLevel: 'strict',
          theme: 'base',
          fontFamily:
            "'Courier New', 'PingFang TC', 'Noto Sans Mono CJK TC', 'Noto Sans TC', monospace",
          themeVariables: {
            darkMode: true,
            background: v('--bg-deep'),
            primaryColor: v('--bg'),
            primaryTextColor: v('--fg'),
            primaryBorderColor: v('--fg'),
            secondaryColor: v('--bg-deep'),
            tertiaryColor: v('--bg-deep'),
            lineColor: v('--fg'),
            textColor: v('--fg'),
            mainBkg: v('--bg'),
            nodeBorder: v('--fg'),
            clusterBkg: v('--bg-deep'),
            clusterBorder: v('--fg-dim'),
            edgeLabelBackground: v('--bg-deep'),
            titleColor: v('--fg-bright'),
          },
        });
        const nodes: HTMLElement[] = [];
        codes.forEach((code) => {
          const box = document.createElement('div');
          box.className = 'mermaid';
          box.textContent = code.textContent ?? '';
          code.parentElement!.replaceWith(box);
          nodes.push(box);
        });
        await mermaid.run({ nodes });
      })();

      window.addEventListener('keydown', (e) => {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        const t = e.target as HTMLElement;
        if (t.closest('input, textarea, select, [contenteditable]')) return;
        switch (e.key.toLowerCase()) {
          // Each hotkey is listed twice: the Latin key and the same
          // physical key under a Russian keyboard layout.
          case 'h':
          case 'р':
            location.href = document.body.dataset.home ?? '/';
            break;
          case 'a':
          case 'ф':
            location.href = document.body.dataset.archive ?? '/blog/';
            break;
          case 'k': // search
          case 'л':
          case '/':
            e.preventDefault();
            location.href = document.body.dataset.search ?? '/search/';
            break;
          case 'l': // switch language
            if (document.body.dataset.nextLang) {
              location.href = document.body.dataset.nextLang;
            }
            break;
        }
      });
    </script>
  </body>
</html>
