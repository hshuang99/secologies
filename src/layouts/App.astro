---
import { Font, type CssVariable } from "astro:assets";
import { getRelativeLocaleUrl, getAbsoluteLocaleUrl } from "astro:i18n";
import config from "$config";
import Analytics from "$components/Analytics.astro";
import alternates from "$lib/alternates";

const { locale, title, subtitle, description, author, article } = Astro.props;

const mainFonts: Record<string, CssVariable> = {
	en: "--font-noto-serif",
	"zh-cn": "--font-noto-serif-sc",
	"zh-tw": "--font-zh-tw",
	ja: "--font-noto-serif-jp"
};

const localedMainFont = mainFonts[locale];

const route = Astro.url.pathname.slice(`/${locale === config.i18n.defaultLocale ? "" : locale}`.length);

// Only declare the languages this page really exists in
const available = await alternates(route);
const fallback = available.includes(config.i18n.defaultLocale) ? config.i18n.defaultLocale : available[0];
const hreflang = (code: string) => code.replace(/-(\w+)/, (_: any, region: string) => `-${region.toUpperCase()}`);

// Structured data (JSON-LD)
const url = new URL(Astro.url.pathname, Astro.site).toString();
const structured = article
	? {
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: subtitle,
			description,
			datePublished: article.timestamp.toISOString(),
			inLanguage: locale,
			mainEntityOfPage: url,
			image: new URL(`${Astro.url.pathname}/graph.png`, Astro.site).toString(),
			author: { "@type": "Person", name: author },
			keywords: article.tags?.join(", ")
		}
	: {
			"@context": "https://schema.org",
			"@type": "WebSite",
			name: title,
			description,
			url: new URL(getRelativeLocaleUrl(locale), Astro.site).toString(),
			inLanguage: locale
		};
---

<html lang={locale} dir={["ar", "he", "fa", "ur"].includes(locale) ? "rtl" : "ltr"}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{subtitle && `${subtitle} |`} {title}</title>
		<meta name="description" content={description} />

		<link rel="alternate" type="application/atom+xml" {title} href={getRelativeLocaleUrl(locale, "/feed.xml").replace(/\/$/, "")} />

		<meta property="og:title" content={`${subtitle && `${subtitle} | `}${title}`} />
		<meta property="og:type" content={(article && "article") || "website"} />
		<meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content={title} />
		<meta property="og:locale" content={locale.replace(/-(\w+)/, (_: any, region: string) => `_${region.toUpperCase()}`)} />

		<meta property="og:image" content={article ? new URL(`${Astro.url.pathname}/graph.png`, Astro.site) : new URL("graph.png", Astro.site)} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />

		{
			article && (
				<>
					<meta property="article:author" content={author} />
					<meta property="article:published_time" content={article.timestamp.toISOString()} />
					{article.section && <meta property="article:section" content={article.section} />}
					{article.tags?.map((tag: string) => (
						<meta property="article:tag" content={tag} />
					))}
				</>
			)
		}

		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<Font cssVariable="--font-playwrite-mx" />
		<Font cssVariable="--font-the-peak-font-plus" />
		<Font cssVariable="--font-maple-mono-nf-cn" />
		<Font cssVariable={localedMainFont} />

		<style set:html={`[lang="${locale}"]{--font-serif:var(${localedMainFont})}`}></style>

		{available.map(code => <link rel="alternate" hreflang={hreflang(code)} href={getAbsoluteLocaleUrl(code, route)} />)}
		<link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(fallback, route)} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, "\\u003c")}></script>

		<Analytics />

		<script is:inline>
			var theme = localStorage.getItem("theme");
			var prefers = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			document.documentElement.dataset.theme = theme || prefers;
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>
